{
  "name": "rowpack",
  "version": "0.1.0",
  "description": "A toy JavaScript bundler whose output is a SQLite database. Linking, tree-shaking and patching are SQL queries.",
  "type": "module",
  "bin": {
    "rowpack": "./bin/rowpack.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "node --test test/",
    "bench": "node bench/run.js"
  },
  "keywords": [
    "bundler",
    "sqlite",
    "esm",
    "toy"
  ],
  "license": "MIT",
  "dependencies": {
    "acorn": "^8.19.0",
    "estree-walker": "^3.0.3",
    "is-reference": "^3.0.3",
    "periscopic": "^4.0.3",
    "sql.js": "^1.17.0"
  },
  "devDependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-lambda": "^3.1177.0",
    "@aws-sdk/client-s3": "^3.1177.0",
    "@aws-sdk/credential-provider-node": "^3.972.99",
    "@smithy/node-http-handler": "^4.14.2",
    "@smithy/signature-v4": "^5.7.5",
    "date-fns": "^4.4.0",
    "esbuild": "^0.28.2",
    "flatpickr": "^4.6.13",
    "lodash-es": "^4.18.1",
    "playwright-core": "^1.65.1",
    "sass": "^1.108.2",
    "three": "^0.187.0",
    "undici": "^8.13.1"
  }
}
