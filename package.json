{
  "name": "rowpack",
  "version": "0.1.0",
  "description": "A toy JavaScript bundler whose output is a SQLite database. Linking, tree-shaking and patching are SQL queries.",
  "type": "module",
  "bin": {
    "rowpack": "./bin/rowpack.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "node --test test/",
    "bench": "node bench/run.js"
  },
  "keywords": ["bundler", "sqlite", "esm", "toy"],
  "license": "MIT",
  "dependencies": {
    "acorn": "^8.19.0",
    "estree-walker": "^3.0.3",
    "is-reference": "^3.0.3",
    "magic-string": "^1.4.5",
    "periscopic": "^4.0.3",
    "sql.js": "^1.15.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.64.1"
  }
}
